<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABOUT THE APP"
            android:textColor="#183B68"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Excess Baggage Fee Calculator"
            android:textColor="#183B68"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This application estimates excess baggage weight, calculates the additional baggage charge, and adds the assumed 8% service tax."
            android:textColor="#26364A"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DEVELOPER DETAILS"
            android:textColor="#183B68"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/studentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Name: MOHAMAD DENNIS LUQMAN\nStudent Number: 2025485938\nGroup: RSC2515B\nProgramme Code: CS251\nCourse: ICT602"
            android:textColor="#26364A"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="APPLICATION WEBSITE"
            android:textColor="#183B68"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/websiteLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Open project website"
            android:textColor="#1565C0"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="© 2026 Excess Baggage Calculator. All rights reserved."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Back to Calculator"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
